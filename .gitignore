<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>امتحان إلكتروني: إدارة المشروعات – الوحدة الأولى</title>
<style>
:root{--bg:#f3f1ff;--card:#fff;--ink:#241f4a;--mute:#6b6894;--line:#dcd8f5;--pri:#5b46e0;--pri2:#8a5cf6;--acc:#ff9f1c;--ok:#0f9d58;--okbg:#e2f6ec;--no:#e0373f;--nobg:#fde8e9}
@media(prefers-color-scheme:dark){:root{--bg:#14122b;--card:#1f1c3d;--ink:#eeecff;--mute:#a9a5d6;--line:#38336a;--pri:#9c8cff;--pri2:#b48cff;--ok:#4fd69c;--okbg:#14362a;--no:#ff7b84;--nobg:#3c1d27}}
*{box-sizing:border-box}
html{padding-top:env(safe-area-inset-top,0)}
body{margin:0;background:var(--bg);color:var(--ink);font:17px/1.8 "Noto Naskh Arabic","Segoe UI",Tahoma,system-ui,sans-serif}
main{max-width:680px;margin:0 auto;padding:14px 14px 40px}
.hero{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;border-radius:18px;padding:22px 20px;margin-bottom:14px}
.hero h1{font-size:1.45rem;margin:0 0 4px;line-height:1.5}.hero p{margin:0;opacity:.92}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 6px 18px rgba(91,70,224,.08)}
.top{display:flex;justify-content:space-between;font-weight:700;color:var(--mute);font-size:.95rem}
.pg{height:8px;background:var(--line);border-radius:4px;overflow:hidden;margin:6px 0 4px}
.pg i{display:block;height:100%;background:linear-gradient(90deg,var(--pri),var(--acc));width:0;transition:width .3s;border-radius:4px}
.tag{display:inline-block;font-size:.85rem;font-weight:700;color:var(--pri);background:color-mix(in srgb,var(--pri) 12%,transparent);padding:0 12px;border-radius:99px}
.q{font-size:1.15rem;font-weight:700;margin:10px 0 12px;line-height:1.8}
.opt{display:flex;gap:12px;align-items:center;width:100%;text-align:right;font:inherit;color:inherit;background:var(--card);padding:11px 12px;margin:9px 0;border:2px solid var(--line);border-radius:12px;cursor:pointer;transition:transform .12s,border-color .12s}
.opt:active{transform:scale(.98)}
.opt b{flex:none;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:color-mix(in srgb,var(--pri) 14%,transparent);color:var(--pri);font-size:.95rem}
.opt.sel{border-color:var(--pri);background:color-mix(in srgb,var(--pri) 12%,transparent)}
.opt.sel b{background:var(--pri);color:#fff}
.opt.ok{border-color:var(--ok);background:var(--okbg)}.opt.ok b{background:var(--ok);color:#fff}
.opt.bad{border-color:var(--no);background:var(--nobg)}.opt.bad b{background:var(--no);color:#fff}
button{font:inherit}
.btn{font-weight:700;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;border:0;border-radius:12px;padding:10px 26px;cursor:pointer}
.btn.alt{background:#fff;color:#4a35c9;border:2px solid #fff;box-shadow:0 3px 10px rgba(0,0,0,.35)}
.btn:disabled{opacity:.6;cursor:default}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
.nav{display:flex;justify-content:space-between;gap:10px;margin-top:14px}
.note{margin-top:8px;padding:8px 12px;border-radius:10px;background:var(--okbg);color:var(--ok);font-size:.95rem}
.rv{border-inline-start:6px solid var(--ok)}.rv.w{border-inline-start-color:var(--no)}
.res{text-align:center}.res b{font-size:3rem;line-height:1.3;display:block;background:linear-gradient(135deg,var(--pri),var(--acc));-webkit-background-clip:text;background-clip:text;color:transparent}
.row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:12px}
label.sh{display:flex;gap:8px;align-items:center;margin:14px 0}label.sh input{accent-color:var(--pri);width:20px;height:20px}
body::before{content:"";position:fixed;inset:0;z-index:-1;background:linear-gradient(rgba(20,18,43,.45),rgba(20,18,43,.72)),url(data:image/jpeg;base64,) center top/cover no-repeat}
.top{color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.6)}
.credit{margin:22px 0 4px;text-align:center;color:#fff;font-weight:700;text-shadow:0 1px 4px rgba(0,0,0,.7)}
.hero p+p{margin-top:6px;font-weight:700}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<section id="start">
<div class="hero"><h1>امتحان إدارة المشروعات</h1><p>الوحدة الأولى: الدروس 1 إلى 4</p><p>إعداد المعلم: أحمد عمر زيد السواغنة</p></div>
<div class="card">
<p>يضم الامتحان <b id="n"></b> سؤالاً، تظهر سؤالاً واحداً في كل مرة. اختر إجابتك وسينتقل الامتحان إلى السؤال التالي تلقائياً. تظهر العلامة والتصحيح في النهاية.</p>
<label class="sh"><input type="checkbox" id="shuf"> ترتيب الأسئلة عشوائياً</label>
<button class="btn" id="go">ابدأ الامتحان</button>
</div>
</section>
<section id="exam" hidden>
<div class="top"><span id="cnt"></span><span id="pc"></span></div>
<div class="pg"><i id="pb"></i></div>
<div class="card"><span class="tag" id="tg"></span><div class="q" id="qt"></div><div id="ops"></div></div>
<div class="nav"><button class="btn alt" id="prev">السابق</button><button class="btn" id="next">التالي</button></div>
</section>
<section id="out" hidden>
<div class="card res" id="res"></div>
<div class="row"><button class="btn alt" id="only">عرض الأخطاء فقط</button><button class="btn" id="again">محاولة جديدة</button></div>
<div id="rv"></div>
</section>
<div class="credit">إعداد المعلم: أحمد عمر زيد السواغنة</div>
</main>
<script>
const M=[
["العبارة التي تشير إلى مفهوم المشروع هي:",["نشاط يومي متكرر.","نشاط أو عمل منتج يؤديه فرد أو مجموعة من الأفراد.","عمل عشوائي من دون أي تخطيط.","مهمة فردية طويلة الأمد."],1],
["من خصائص المشروع:",["عدم وجود وقت محدد لتنفيذه.","حاجته إلى موارد مثل المال والوقت والجهد.","وجود بداية محددة ونهاية مفتوحة له.","تنفيذه بصورة عشوائية."],1],
["المسؤول عن متابعة تنفيذ المشروع وتنظيم آلية العمل والتخطيط له هو:",["راعي المشروع.","أحد أصحاب المصلحة.","مدير المشروع.","المستفيد."],2],
["الهدف الرئيسي من تأسيس المشروع هو:",["القيام بأعمال يومية متكررة.","تحقيق الربح أو إنتاج سلعة/تقديم خدمة.","التوسع غير المخطط له.","إلغاء الحاجة للتمويل."],1],
["الاسم الذي يُطلق على مَنْ يُقدّم الدعم والموارد للمشروع هو:",["مدير المشروع.","فريق المشروع.","راعي المشروع.","المستفيد."],2],
["تشير عبارة «الأشخاص أو الجهات التي لها علاقة مباشرة أو غير مباشرة بالمشروع؛ سواء أكان ذلك بالمشاركة فيه أم بالاستفادة منه، أو تتأثر بنتائجه» إلى:",["مدير المشروع.","فريق المشروع.","راعي المشروع.","أصحاب المصلحة."],3],
["من الأمثلة على أصحاب المصلحة في المشروع:",["المستفيدون والمجتمع المحلي.","الجهات الداعمة وأولياء الأمور.","فريق المشروع.","جميع ما ذكر صحيح."],3],
["من مراحل إدارة المشروع:",["اختيار الصف.","تنظيم الحصص.","تسليم الواجبات.","تنفيذ المشروع."],3],
["المرحلة التي تُحدّد فيها الأنشطة والجدول الزمني هي:",["بدء المشروع.","إنهاء المشروع.","تخطيط المشروع.","التأمل."],2],
["يهدف توزيع الأدوار على أعضاء فريق المشروع إلى:",["زيادة عدد الأعضاء.","خفض مستوى التعاون.","تنظيم العمل.","تأخير عملية التنفيذ."],2],
["المرحلة التي يُعلن فيها عن اكتمال المشروع وتقييم نتائجه تُسمى:",["بدء المشروع.","مراقبة المشروع.","إنهاء المشروع.","تخطيط المشروع."],2],
["الأشخاص الذين يعملون معاً لتنفيذ المشروع يُطلق عليهم:",["راعي المشروع.","أصحاب المصلحة الخارجيون.","فريق المشروع.","الموردون."],2],
["يُستفاد مِنْ نموذج بَدْء المشروع (Project Charter) في:",["تنفيذ المشروع مباشرة.","توضيح فكرة المشروع وأهدافه العامة والمساعدة على اتخاذ قرار بدء التنفيذ.","تقييم المشروع النهائي.","كتابة التقرير الختامي."],1],
["يهدف نموذج نطاق المشروع إلى:",["توضيح فكرة المشروع وأهدافه العامة.","إنهاء المشروع، ومتابعة مدى تقدمه.","بيان تسلسل أنشطة المشروع.","تحديد ما يشمله المشروع، وما لا يشمله."],3],
["يساعد نموذج الجدول الزمني فريق المشروع على:",["تنظيم الوقت ومواعيد تنفيذ الأنشطة.","إنهاء المشروع فوراً.","إلغاء الموارد المادية.","زيادة التكاليف التشغيلية."],0],
["التخطيط المكتوب يُعدّ:",["الخطوة الأولى لنجاح أي مشروع.","إجراءً غير مهم في إدارة المشروعات.","سبباً في تعقيد العمل وتأخيره.","بديلاً عن مرحلة التنفيذ."],0],
["إحدى الآتية تُعدّ مثالاً واضحاً على المشروع:",["تنظيم الحصص اليومية.","تنظيف الغرفة الصفية يومياً.","تنفيذ حملة مدرسية مدة أسبوع كامل.","أداء الواجبات المدرسية."],2],
["من مسؤوليات راعي المشروع:",["توزيع المهام اليومية.","متابعة تنفيذ الأنشطة.","توفير الدعم، والموافقة على المشروع.","كتابة التقرير النهائي للمشروع."],2],
["من مزايا تحديد نطاق المشروع:",["بيان تسلسل أنشطة المشروع.","منع التوسع غير المخطط له.","تكوين صورة واضحة عن المشروع.","تقليل عدد أعضاء الفريق."],1],
["اسم المرحلة التي تتضمن متابعة التقدم في سير العمل ومعالجة المشكلات التي تعترض التنفيذ هي:",["بدء المشروع","تخطيط المشروع","تنفيذ المشروع","مراقبة المشروع والتحكم فيه"],3],
["الشخص المسؤول عن التخطيط ومتابعة سير المشروع يومياً هو:",["راعي المشروع","مدير المشروع","المستفيد","صاحب المصلحة الخارجي"],1],
["النموذج الذي يبين تسلسل الأنشطة والمدة الزمنية المحددة لكل منها هو:",["نطاق المشروع","نموذج بدء المشروع","الجدول الزمني","تقرير المراقبة"],2],
["تتيح مرحلة مراقبة المشروع لفريق العمل:",["اكتشاف المشكلات مبكراً أثناء عملية التنفيذ.","إنهاء المشروع قبل بدء التخطيط.","إلغاء الموارد المادية.","زيادة عدد أصحاب المصلحة."],0],
["الجهة المسؤولة عن تقديم الدعم وتوفير الميزانية اللازمة للمشروع هي:",["مدير المشروع","راعي المشروع","المستفيدون","أصحاب المصلحة الخارجيون"],1],
["أيّ مما يأتي يُعد من أصحاب المصلحة في المشروع المدرسي:",["الطلبة وأولياء الأمور","إدارة المدرسة والجهات الداعمة","المجتمع المحلي","جميع ما ذكر صحيح"],3],
["الوثيقة الأولية التي تُستخدم لتوضيح فكرة المشروع وأهدافه العامة والمساعدة على اتخاذ قرار البدء بتنفيذه هي:",["نموذج بدء المشروع (Project Charter)","نموذج نطاق المشروع","الجدول الزمني","تقرير المراقبة"],0],
["تحديد ما يشمله المشروع وما لا يشمله يهدف أساساً إلى:",["تقليل أعداد فريق العمل","منع التوسع غير المخطط له أثناء التنفيذ","زيادة التكاليف التشغيلية","إلغاء الموارد المادية"],1]
];
const T=[
["يُعرف المشروع بأنه عمل روتيني متكرر يفتقر إلى الموارد والتخطيط.",false,"المشروع نشاط أو عمل منتج يحتاج موارد وتخطيط محدد."],
["يتطلب نجاح المشروع وجود إدارة جيدة ومدير يتحلى بمهارات قيادية وتنظيمية.",true],
["يعتمد نجاح المشروع على الفكرة فقط ولا يحتاج إلى إدارة جيدة.",false,"نجاح المشروع يلزمه وجود إدارة جيدة ومدير متميز."],
["يتولى مدير المشروع ضمان تحقيق أهداف المشروع في الوقت المحدد بحسب الموارد المتاحة.",true],
["راعي المشروع يُنفّذ أنشطة المشروع اليومية.",false,"مدير المشروع هو من يتولى إدارة العمل اليومي."],
["مدير المشروع يُقدّم التمويل اللازم للمشروع.",false,"راعي المشروع هو من يقدم التمويل والدعم والموارد."],
["راعي المشروع يتولّى فقط مراقبة تنفيذ المشروع.",false,"يتولى تقديم الدعم والموافقة على الخطط والتغييرات والموارد."],
["تؤدّي إدارة المشروع وراعي المشروع الدور نفسه.",false,"لكل منهما دور ومسؤوليات مختلفة ومحددة."],
["التمييز بين دور راعي المشروع ومدير المشروع يقلل من المشكلات ويسهم في إنجاز العمل بكفاءة.",true],
["تبدأ مراحل إدارة المشروع بمرحلة بدء المشروع.",true],
["تقتصر وظائف المشروع على تحقيق الربح المالي فقط ولا تشمل خدمة المجتمع.",false,"تشمل إنتاج السلع، تقديم الخدمات، توفير فرص العمل، وتنمية الاقتصاد."],
["تقتصر وظائف المشروع على تحقيق الربح المالي فقط ولا تشمل توفير فرص العمل أو تنمية الاقتصاد.",false,"تشمل وظائف المشروع إنتاج السلع، تقديم الخدمات، تحقيق الربح، توفير فرص العمل، تنمية الاقتصاد، وتلبية حاجات المجتمع."],
["يساعد تحديد الأدوار وتوزيع المسؤوليات بوضوح في الالتزام بالوقت وتعزيز التعاون وتقليل التحديات.",true],
["مرحلة مراقبة المشروع تعني متابعة التقدم في سير العمل ومعالجة المشكلات التي تعترض التنفيذ.",true],
["يتضمن نموذج بدء المشروع عناصر رئيسة منها: اسم المشروع، فكرته، هدفه، والجهة المستفيدة، ومدته.",true],
["يُساعد تحديد نموذج نطاق المشروع على منع التوسع غير المخطط له أثناء تنفيذ المشروع.",true],
["البدء بتنفيذ المشروع من دون تخطيط مكتوب يُسهل عملية الإدارة ويقلل المخاطر.",false,"التخطيط المكتوب هو الأساس، والبدء بدونه يزيد من احتمال الوقوع في المشكلات."],
["يُحدد نموذج الجدول الزمني تسلسل الأنشطة والمدة الزمنية وتاريخ البدء والانتهاء لكل منها.",true],
["يُقصد بفريق المشروع الأشخاص الذين يعملون معاً لتنفيذ المشروع.",true],
["التمييز بين العمل الروتيني والمشروع يكمن في أن المشروع له بداية ونهاية محددة ويحتاج إلى موارد وتخطيط.",true],
["تحديد نطاق المشروع يتسبب في التوسع غير المخطط له أثناء التنفيذ.",false,"يهدف تحديد نطاق المشروع إلى منع التوسع غير المخطط له."],
["يسهم تحديد الأدوار وتوزيع المسؤوليات في تقليل التحديات والمشكلات أثناء تنفيذ المشروع.",true],
["يقتصر مفهوم المشروع على الأعمال اليومية الروتينية المتكررة.",false,"المشروع نشاط أو عمل منتج يحتاج موارد وتخطيط محدد."],
["تختلف مسؤوليات راعي المشروع عن مسؤوليات مدير المشروع في عملية إدارة التنفيذ اليومي.",true],
["يبدأ السير في مراحل إدارة المشروع بمرحلة التخطيط مباشرة دون الحاجة لمرحلة بدء المشروع.",false,"تبدأ بمرحلة بدء المشروع ثم التخطيط."],
["يساعد التخطيط المكتوب واستخدام النماذج في تسهيل تنفيذ المشروع وجعله أكثر تنظيماً.",true]
];
const $=id=>document.getElementById(id);
const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const L=["أ","ب","ج","د"];
let Q=[],ans=[],cur=0,timer=null,onlyWrong=false;
$("n").textContent=M.length+T.length;
const opts=q=>q.t=="m"?q.o:["صواب","خطأ"];
const right=q=>q.t=="m"?q.a:(q.a?0:1);
function start(){
 let m=M.map(x=>({t:"m",q:x[0],o:x[1],a:x[2]})),f=T.map(x=>({t:"f",q:x[0],a:x[1],r:x[2]}));
 if($("shuf").checked){shuffle(m);shuffle(f)}
 Q=[...m,...f];ans=Array(Q.length).fill(null);cur=0;
 $("start").hidden=$("out").hidden=true;$("exam").hidden=false;show();
}
function show(){
 const q=Q[cur];
 $("cnt").textContent="سؤال "+(cur+1)+" من "+Q.length;
 $("pc").textContent=ans.filter(x=>x!==null).length+" مُجاب";
 $("pb").style.width=(100*cur/Q.length)+"%";
 $("tg").textContent=q.t=="m"?"اختر الإجابة الصحيحة":"صح أم خطأ";
 $("qt").textContent=q.q;
 $("ops").innerHTML=opts(q).map((o,k)=>`<button class="opt${ans[cur]===k?" sel":""}" data-k="${k}"><b>${q.t=="m"?L[k]:(k?"✗":"✓")}</b><span>${o}</span></button>`).join("");
 $("prev").disabled=cur==0;
 $("next").textContent=cur==Q.length-1?"إنهاء الامتحان":"التالي";
}
function go(d){
 clearTimeout(timer);
 if(cur+d>=Q.length){finish();return}
 cur=Math.max(0,cur+d);show();
}
$("ops").onclick=e=>{
 const b=e.target.closest(".opt");if(!b)return;
 ans[cur]=+b.dataset.k;show();
 $("pc").textContent=ans.filter(x=>x!==null).length+" مُجاب";
 clearTimeout(timer);
 if(cur<Q.length-1)timer=setTimeout(()=>go(1),450);
};
$("next").onclick=()=>go(1);$("prev").onclick=()=>go(-1);
function finish(){
 const left=ans.filter(x=>x===null).length;
 if(left&&!confirm("بقي "+left+" سؤالاً من دون إجابة. هل تريد إنهاء الامتحان؟"))return;
 let sc=0;Q.forEach((q,i)=>{if(ans[i]===right(q))sc++});
 const p=Math.round(100*sc/Q.length);
 const msg=p>=90?"ممتاز! 🌟":p>=75?"جيد جداً 👏":p>=50?"جيد، راجع الأسئلة التي أخطأت فيها":"تحتاج إلى مراجعة الدروس ثم إعادة المحاولة";
 $("res").innerHTML=`<b>${sc} / ${Q.length}</b>${p}% — ${msg}`;
 onlyWrong=false;$("only").textContent="عرض الأخطاء فقط";renderRv();
 $("exam").hidden=true;$("out").hidden=false;scrollTo(0,0);
}
function renderRv(){
 $("rv").innerHTML=Q.map((q,i)=>{
  const r=right(q),ok=ans[i]===r;
  if(onlyWrong&&ok)return"";
  const o=opts(q).map((t,k)=>`<div class="opt${k==r?" ok":k==ans[i]?" bad":""}"><b>${q.t=="m"?L[k]:(k?"✗":"✓")}</b><span>${t}</span></div>`).join("");
  const note=(ans[i]===null?"لم تُجب عن هذا السؤال. ":"")+(q.r?"التصحيح: "+q.r:"");
  return`<div class="card rv${ok?"":" w"}"><div class="q">${i+1}) ${q.q}</div>${o}${(!ok||q.r)&&note?`<div class="note">${note}</div>`:""}</div>`;
 }).join("")||'<div class="card res">لا توجد أخطاء، أحسنت!</div>';
}
$("only").onclick=()=>{onlyWrong=!onlyWrong;$("only").textContent=onlyWrong?"عرض كل الأسئلة":"عرض الأخطاء فقط";renderRv()};
$("go").onclick=start;$("again").onclick=()=>{$("out").hidden=true;$("start").hidden=false;scrollTo(0,0)};
</script>
</body>
</html>
